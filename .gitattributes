# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Files executed inside Linux containers MUST stay LF.
*.sh       text eol=lf
*.conf     text eol=lf
Dockerfile text eol=lf
*.go       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
