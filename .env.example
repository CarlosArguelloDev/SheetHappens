# =========================================================
# SheetHappens - Environment configuration template
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit the real `.env` file.
# =========================================================

# ---------- Go print-api ----------
# TCP port the Go HTTP server listens on inside the container.
PORT=8080

# Hostname (and optional :port) of the CUPS server reachable from print-api.
# Inside docker compose this is the service name of the CUPS container.
CUPS_HOST=cups:631

# Printer queue name used when the client does not select one.
# Leave empty to fall back to the CUPS system default destination.
DEFAULT_PRINTER=HP_DeskJet_2300

# Maximum accepted upload size in megabytes (enforced via http.MaxBytesReader).
MAX_UPLOAD_MB=20

# ---------- CUPS administration ----------
# Credentials of the Linux user provisioned inside the CUPS container
# (member of the `lpadmin` group) used to log into https://<HOST-IP>:631/admin
CUPS_ADMIN_USER=printadmin
CUPS_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---------- Cloudflare Tunnel ----------
# Token from Cloudflare Zero Trust > Networks > Tunnels > <your tunnel> > Install connector.
CF_TUNNEL_TOKEN=
